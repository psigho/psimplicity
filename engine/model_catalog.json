{
  "_meta": {
    "note": "Image-model catalog. Each entry maps to a runtime provider (fal_ai | bfl | replicate | gemini_api_key | seedream | dalle). Hand-curated from research + cross-referenced with OGA (K:/Gen Media/Open-Generative-AI/packages/studio/src/models.js). Edit freely.",
    "version": 1,
    "schema": {
      "id": "stable identifier — used by Streamlit as the dropdown key",
      "label": "human-readable name + emoji",
      "provider": "config_key that selects which subclass create_provider() uses",
      "endpoint": "provider-specific model slug (fal-ai/...) or endpoint name (flux-pro-1.1) or replicate model id (owner/name)",
      "tier": "fast | balanced | premium — controls sort/grouping in UI",
      "mode": "t2i | i2i — text-to-image vs image-to-image (i2i needs reference_images)",
      "cost_per_image": "USD estimate at time of writing",
      "supports_reference": "true if model accepts reference images",
      "disabled": "true if model exists in OGA catalog but has no public API (e.g. Midjourney)",
      "params": "optional dict of provider-specific defaults forwarded into provider.default_params"
    }
  },
